{
  "name": "tlp-mail-marker",
  "version": "0.3.0",
  "private": true,
  "description": "Apply FIRST TLP 2.0 markings to outgoing email in Roundcube Webmail and Thunderbird.",
  "license": "MIT",
  "author": "mustafa-kamoona",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mustafa-kamoona/tlp-mail-marker.git"
  },
  "homepage": "https://github.com/mustafa-kamoona/tlp-mail-marker#readme",
  "bugs": {
    "url": "https://github.com/mustafa-kamoona/tlp-mail-marker/issues"
  },
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs --target=production",
    "build:dev": "node scripts/build.mjs --target=development",
    "build:e2e": "node scripts/build.mjs --target=e2e",
    "build:firefox": "node scripts/build.mjs --browser=firefox --target=production",
    "build:firefox:dev": "node scripts/build.mjs --browser=firefox --target=development",
    "package:firefox": "node scripts/package.mjs --browser=firefox",
    "build:thunderbird": "node scripts/build-thunderbird.mjs",
    "package:thunderbird": "node scripts/package-thunderbird.mjs",
    "package": "node scripts/package.mjs",
    "release": "npm run clean && npm run build && npm run package && npm run build:firefox && npm run package:firefox && npm run build:thunderbird && npm run package:thunderbird && node scripts/package-beta.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:automation": "node --test tests/automation/*.test.mjs",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e/run.mjs",
    "e2e:firefox": "node tests/firefox/run.mjs",
    "e2e:thunderbird": "node tests/thunderbird/run.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
